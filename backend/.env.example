DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/recruitment_db?schema=public"
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=super-secret-jwt-access-key-at-least-32-chars
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Bỏ comment để bật gửi email qua Mailtrap Email Sandbox.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_sandbox_username
# SMTP_PASS=your_sandbox_password
# SMTP_FROM=recruitment@example.com
